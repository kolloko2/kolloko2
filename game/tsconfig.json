{
  // Проверка типов поверх JavaScript (JSDoc): код остаётся без сборки, tsc только ищет ошибки.
  //   npm run typecheck
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/types/*.d.ts", "server/*.mjs", "tools/*.mjs"]
}
